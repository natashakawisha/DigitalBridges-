# ===== Digital Bridges Zambia — example environment =====
# Copy this file to .env and fill in real values. NEVER commit .env.
# The app reads these at startup via src/config.js; this file holds fake
# placeholder values only.

# Server
PORT=3000

# Session signing key — use a long random string in production
SESSION_SECRET=replace-with-a-long-random-secret

# Admin CMS login (served at /admin)
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password. Generate one with:
#   node scripts/hash-password.js "your-password"
ADMIN_PASSWORD_HASH=$2b$10$REPLACE_WITH_A_BCRYPT_HASH

# Contact-form email notifications (Gmail App Password)
EMAIL_USER=you@example.com
EMAIL_PASS=your-gmail-app-password
